rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Every account can access only its own profile and writing archive.
    match /users/{userId} {
      allow read, create, update, delete: if request.auth != null
        && request.auth.uid == userId;

      match /fics/{ficId} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid == userId;
      }

      match /vault/{documentId} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid == userId;
      }

      // OAuth refresh tokens are server-only. Cloud Functions use the Admin SDK;
      // browser clients must never read or write this integration record.
      match /integrations/{document=**} {
        allow read, write: if false;
      }
    }

    // One-time OAuth state is used only by the server-side callback.
    match /driveOAuthStates/{stateId} {
      allow read, write: if false;
    }
  }
}
